{
  "expo": {
    "name": "stockpilot",
    "slug": "stockpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/beta-app-icon.png",
    "scheme": "stockpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/beta-app-icon.png"
    },
    "android": {
      "icon": "./assets/beta-app-icon.png",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.charles272002.stockpilot"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCleartextTrafficDisabled",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/stockpilot/headMascot-transparent.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockPilot to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d5ec30d-09e6-423e-ba28-b73d56dbbf1c"
      }
    }
  }
}
