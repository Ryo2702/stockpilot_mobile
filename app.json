{
  "expo": {
    "name": "stockpilot",
    "slug": "stockpilot",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "stockpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "icon": "./assets/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "package": "com.charles272002.stockpilot"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/stockpilot/headMascot-transparent.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockPilot to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d5ec30d-09e6-423e-ba28-b73d56dbbf1c"
      }
    }
  }
}
